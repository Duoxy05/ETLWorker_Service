{
  "ConnectionStrings": {
    "OrigenWeb": "Server=localhost;Port=3306;Database=OpinionesOrigenDB;User ID=etl_reader;Password=<DEFINIR_EN_USER_SECRETS>",
    "Analitica": "Server=localhost;Port=3306;Database=SistemaOpinionesDW;User ID=etl_writer;Password=<DEFINIR_EN_USER_SECRETS>",
    "AnaliticaCarga": "Server=localhost;Port=3306;Database=SistemaOpinionesDW;User ID=etl_loader;Password=<DEFINIR_EN_USER_SECRETS>"
  },
  "Secrets": {
    "SocialApiKey": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "System.Net.Http": "Warning" }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}" }
      },
      {
        "Name": "File",
        "Args": { "path": "logs/etl-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14 }
      }
    ]
  },
  "Etl": {
    "MaxDegreeOfParallelism": 3,
    "BatchSize": 500,
    "ChannelCapacity": 2000,
    "IntervalMinutes": 0,
    "RunExtraction": true,
    "Catalogs": {
      "ClientesPath": "data/clients.csv",
      "ClientesIdColumn": "IdCliente",
      "ProductosPath": "data/products.csv",
      "ProductosIdColumn": "IdProducto",
      "ClientesNombreColumn": "Nombre",
      "ClientesEmailColumn": "Email",
      "ProductosNombreColumn": "Nombre",
      "ProductosCategoriaColumn": "Categoría"
    },
    "Dimensions": {
      "Enabled": true,
      "CalendarStartYear": 2024,
      "CalendarEndYear": 2025,
      "Fuentes": [
        { "Canal": "Encuesta", "StagingTable": "stg_encuestas" },
        { "Canal": "Web", "Plataforma": "Sitio web" },
        { "Canal": "Red social", "StagingTable": "stg_comentarios_sociales" }
      ]
    },
    "Sources": [
      {
        "Name": "Encuestas",
        "Type": "Csv",
        "Enabled": true,
        "StagingTable": "stg_encuestas",
        "Csv": { "Path": "data/surveys_part1.csv", "Delimiter": ",", "Encoding": "utf-8" },
        "Fields": {
          "IdOrigen": "IdOpinion", "IdCliente": "IdCliente", "IdProducto": "IdProducto",
          "Fecha": "Fecha", "Comentario": "Comentario",
          "Puntaje": "PuntajeSatisfacción", "Clasificacion": "Clasificación", "Plataforma": "Fuente"
        }
      },
      {
        "Name": "ResenasWeb",
        "Type": "Database",
        "Enabled": true,
        "StagingTable": "stg_resenas_web",
        "Database": {
          "ConnectionName": "OrigenWeb",
          "CommandTimeoutSeconds": 60,
          "Query": "SELECT IdReview, IdCliente, IdProducto, DATE_FORMAT(Fecha, '%Y-%m-%d') AS Fecha, Comentario, Rating FROM web_reviews ORDER BY IdReview"
        },
        "Fields": {
          "IdOrigen": "IdReview", "IdCliente": "IdCliente", "IdProducto": "IdProducto",
          "Fecha": "Fecha", "Comentario": "Comentario", "Puntaje": "Rating"
        }
      },
      {
        "Name": "ComentariosSociales",
        "Type": "Api",
        "Enabled": true,
        "StagingTable": "stg_comentarios_sociales",
        "Api": {
          "BaseUrl": "http://localhost:5080/",
          "Endpoint": "api/comments",
          "PageSize": 50,
          "MaxRetries": 3,
          "TimeoutSeconds": 30,
          "ApiKeyHeader": "X-Api-Key",
          "ApiKeySecret": "SocialApiKey",
          "DataProperty": "data",
          "TotalProperty": "total"
        },
        "Fields": {
          "IdOrigen": "IdComment", "IdCliente": "IdCliente", "IdProducto": "IdProducto",
          "Fecha": "Fecha", "Comentario": "Comentario", "Plataforma": "Fuente"
        }
      }
    ]
  }
}
